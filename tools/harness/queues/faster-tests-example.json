{
  "note": "docs/170 example: several repros in one load (job 1) and session reuse across jobs (jobs 2-3, queue-level reuseSession). Same game start as scenario-hitches.json. Dry run: node tools/harness/queue.ts tools/harness/queues/faster-tests-example.json --dry-run. Not run in the game yet.",
  "reuseSession": {
    "maxJobs": 5
  },
  "jobs": [
    {
      "id": "bp-scen-multi",
      "note": "scenario repros lotswitch, buildbuy, cas back to back in one load; each its own tag <job tag>-<repro id>; read: hitch-ab.ts --scenario <job tag>",
      "asi": "game-copy/ts3native.asi.0329",
      "save": "Baseline-BP-Spring",
      "minCounters": 90,
      "ini": {
        "SlotEnabledRO.Enabled": 1,
        "SlotEnabledRO.Mode": 1,
        "SlotEnabledRO.Shadow": 0,
        "UnseenThrottle.Enabled": 1,
        "UnseenThrottle.List": 1,
        "RouteAsync.FallbackAsync": 1,
        "RouteAsync.M1Retry": 1,
        "RouteAsync.SyncCapMs": 1000,
        "RouteAsync.FbJobCapMs": 300,
        "RouteAsync.LogFallbackMs": 20,
        "RouteAsync.LogFallbackStack": 16,
        "RouteAsync.TailUnlock": 1,
        "RouteAsync.ReplanDedupe": 1,
        "RouteAsync.H2": 1,
        "RouteEarlyOut.Enabled": 1,
        "RouteEarlyOut.Mode": 2,
        "RouteEarlyOut.Act": 1,
        "RouteEarlyOut.LogMs": 200,
        "HitchAttr.Enabled": 1,
        "Harness.ForegroundRender": 1,
        "RouteJobPhases.Enabled": 1,
        "RouteJobPhases.SyncPlans": 1
      },
      "gameArgs": [
        "-disablestoryprogression"
      ],
      "run": {
        "profile": {
          "seed": 12345,
          "fixesOn": "legreplanskip,bouncerskip,idlememo,stuckcheckasync,errortrapspread",
          "noSamplers": true,
          "minutes": 10,
          "repros": [
            "scen-lotswitch",
            "scen-buildbuy",
            {
              "id": "scen-cas",
              "minutes": 8
            }
          ]
        }
      },
      "timeoutMin": 50
    },
    {
