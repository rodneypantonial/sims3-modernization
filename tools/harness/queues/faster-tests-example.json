        "RouteAsync.LogFallbackStack": 16,
        "RouteAsync.TailUnlock": 1,
        "RouteAsync.ReplanDedupe": 1,
        "RouteAsync.H2": 1,
        "RouteEarlyOut.Enabled": 1,
        "RouteEarlyOut.Mode": 2,
        "RouteEarlyOut.Act": 1,
        "RouteEarlyOut.LogMs": 200,
        "HitchAttr.Enabled": 1,
        "Harness.ForegroundRender": 1,
        "RouteJobPhases.Enabled": 1,
        "RouteJobPhases.SyncPlans": 1
      },
      "gameArgs": [
        "-disablestoryprogression"
      ],
      "run": {
        "profile": {
          "seed": 12345,
          "fixesOn": "legreplanskip,bouncerskip,idlememo,stuckcheckasync,errortrapspread",
          "noSamplers": true,
          "minutes": 10
        }
      },
      "timeoutMin": 20
