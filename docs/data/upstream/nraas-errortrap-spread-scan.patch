From 708bafbd0954466ab1ddeec1ebf3dcd483ba37c0 Mon Sep 17 00:00:00 2001
From: Rodney Pantonial <rodneypantonial@users.noreply.github.com>
Date: Wed, 21 Oct 2026 09:52:42 +0800
Subject: [PATCH 2/2] Add ErrorTrap.SpreadScanVersion marker

SpreadScanVersion is a public marker for other mods (for example performance mods that spread the load-up scan themselves) to detect that ErrorTrap does it and stay out of the way.

Assisted with AI
---
 NRaasErrorTrap/ErrorTrap.cs | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/NRaasErrorTrap/ErrorTrap.cs b/NRaasErrorTrap/ErrorTrap.cs
index 35cd1f3..6a6839b 100644
--- a/NRaasErrorTrap/ErrorTrap.cs
+++ b/NRaasErrorTrap/ErrorTrap.cs
@@ -71,6 +71,9 @@ public class ErrorTrap : Common, Common.IStartupApp, Common.IPreLoad, Common.IWo
         [Tunable, TunableComment("Scripting Mod Instantiator, value does not matter, only its existence")]
         protected static bool kInstantiator = false;
 
+        // Read by other mods that would otherwise spread the load-up scan themselves. Bump when that behaviour changes.
+        public static readonly int SpreadScanVersion = 1;
+
         static bool sLoading = true;
         //static bool sDelayLoading = true;
 
