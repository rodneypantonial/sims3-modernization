From 923f8acd478b00da4d7f08f27e86c1d1072877c9 Mon Sep 17 00:00:00 2001
From: Rodney Pantonial <rodneypantonial@users.noreply.github.com>
Date: Fri, 23 Oct 2026 11:13:53 +0800
Subject: [PATCH 1/2] Nightly alarm: one cleanup per frame without spacing

With Set Alarm Spacing at 0 the nightly cleanups ran all in one frame. They now run one per frame: after each cleanup the alarm's task sleeps for one frame (only where sleeping is allowed; the alarm runs in its own FunctionTask, so it is) and the next cleanup starts. Same order, same settings, notices still collected into one message at the end, an exception still stops the rest.

The default spacing is now 0: every cleanup still runs at the alarm hour (stereos and TVs are switched off at the same time as before), but their costs no longer add up in one frame. A spacing above 0 keeps the chained alarms of the previous commit.
---
 NRaasOverwatch/Overwatch.cs                   |  14 +++++++++++---
 .../OverwatchSpace/PersistedSettings.cs       |   4 ++--
 .../StringTables/StringTableEnglish.txt       | Bin 17244 -> 17248 bytes
 3 files changed, 13 insertions(+), 5 deletions(-)

diff --git a/NRaasOverwatch/Overwatch.cs b/NRaasOverwatch/Overwatch.cs
index e47f914..fea743d 100644
--- a/NRaasOverwatch/Overwatch.cs
+++ b/NRaasOverwatch/Overwatch.cs
@@ -156,8 +156,9 @@ namespace NRaas
             RunAlarms(true);
         }
 
-        // Runs the cleanups in order, as one batch like before. With spacing, each next one starts sSpacing sim-minutes after
-        // the previous one finished, so their costs do not add up in one frame. The notices still show as one message at the end.
+        // Runs the cleanups in order, as one batch like before. Without spacing, each next one runs a frame after the previous
+        // one finished; with spacing, sSpacing sim-minutes after. Either way their costs do not add up in one frame. The notices
+        // still show as one message at the end.
         static void RunAlarms(bool spaced)
         {
             List<IAlarmOption> items = sPendingAlarms;
@@ -176,11 +177,18 @@ namespace NRaas
                     // A newer run took over while this cleanup slept
                     if (items != sPendingAlarms) return;
 
-                    if ((spaced) && (sSpacing > 0) && (items.Count > 0))
+                    if (items.Count == 0) break;
+
+                    if ((spaced) && (sSpacing > 0))
                     {
                         sNextAlarm = new AlarmTask(sSpacing, TimeUnit.Minutes, OnNextAlarm);
                         return;
                     }
+
+                    // Without spacing each cleanup gets its own frame (the alarm runs in its own task, so it may sleep)
+                    Common.Sleep();
+
+                    if (items != sPendingAlarms) return;
                 }
             }
             catch (Exception e)
diff --git a/NRaasOverwatch/OverwatchSpace/PersistedSettings.cs b/NRaasOverwatch/OverwatchSpace/PersistedSettings.cs
index 12a0466..f675097 100644
