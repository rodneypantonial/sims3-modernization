# Published on GitHub: keep EA game files, decompiled code, saves and large outputs out of git.

# Game binaries and copied EA files (never commit these)
*.exe
*.exe.orig
*.dll
*.asi
*.package
*.dbc
*.dbp
*.world
*.sims3pack
game-copy/
bin-copy/

# Saves (EA content and personal data)
*.sims3/
*.sims3.backup
*.nhd

# Ghidra / REA projects and analysis databases
*.gpr
*.rep/
/ghidra/
*.idb
*.i64
rea-out/

# Profiling and debugger output
*.dmp
*.etl
*.trace
x32dbg/db/
captures/

# Build output
build/
out/
native/ts3native/out/
Debug/
Release/
# core.ignorecase makes Release/ match our release/ notes folder too; keep it tracked (release/mts/out/ stays ignored via out/)
!/release/
*.obj
*.pdb
*.ilk
*.lib
*.exp

# Editors and OS
.idea/
.vs/
*.user
Thumbs.db
desktop.ini

# Live probe output (events, profiles)
probe-out/
# story census cache (docs/171 §7): Sim names from the player's saves
tools/harness/stories/census/
.claude/worktrees/

# Python bytecode
__pycache__/
*.pyc
