diff --git a/src/vulkan/vulkan_loader.cpp b/src/vulkan/vulkan_loader.cpp
index f9d1e98d..19bc69cf 100644
--- a/src/vulkan/vulkan_loader.cpp
+++ b/src/vulkan/vulkan_loader.cpp
@@ -4,11 +4,77 @@
 
 #include "../util/log/log.h"
 
+#include "../util/util_env.h"
 #include "../util/util_string.h"
 #include "../util/util_win32_compat.h"
 
+#include <mutex>
+#include <unordered_map>
+
 namespace dxvk::vk {
 
+  // TS3 diagnostics: count live pipelines by kind, wrapping the device's create/destroy entry points.
+  static PFN_vkCreateGraphicsPipelines s_diagCreateGraphics = nullptr;
+  static PFN_vkCreateComputePipelines  s_diagCreateCompute  = nullptr;
+  static PFN_vkDestroyPipeline         s_diagDestroy        = nullptr;
+  static std::mutex s_diagMutex;
+  static std::unordered_map<uint64_t, uint32_t> s_diagKinds;
+  static DiagPipelineCounts s_diagCounts = { };
+
+  static uint32_t diagGraphicsKind(const VkGraphicsPipelineCreateInfo& info) {
+    for (auto s = reinterpret_cast<const VkBaseInStructure*>(info.pNext); s; s = s->pNext) {
+      if (s->sType == VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_LIBRARY_CREATE_INFO_EXT)
+        return 0u;
+      if (s->sType == VK_STRUCTURE_TYPE_PIPELINE_LIBRARY_CREATE_INFO_KHR)
+        return 1u;
+    }
+    return 2u;
+  }
+
+  static void diagAdd(VkPipeline p, uint32_t kind) {
+    std::lock_guard lock(s_diagMutex);
+    s_diagKinds[uint64_t(p)] = kind;
+    s_diagCounts.live[kind] += 1;
+    s_diagCounts.created[kind] += 1;
+  }
+
+  static VKAPI_ATTR VkResult VKAPI_CALL diagCreateGraphicsPipelines(VkDevice device, VkPipelineCache cache, uint32_t count,
+      const VkGraphicsPipelineCreateInfo* infos, const VkAllocationCallbacks* alloc, VkPipeline* pipelines) {
+    VkResult vr = s_diagCreateGraphics(device, cache, count, infos, alloc, pipelines);
+    for (uint32_t i = 0; i < count; i++) {
+      if (pipelines[i])
+        diagAdd(pipelines[i], diagGraphicsKind(infos[i]));
+    }
+    return vr;
+  }
+
+  static VKAPI_ATTR VkResult VKAPI_CALL diagCreateComputePipelines(VkDevice device, VkPipelineCache cache, uint32_t count,
+      const VkComputePipelineCreateInfo* infos, const VkAllocationCallbacks* alloc, VkPipeline* pipelines) {
+    VkResult vr = s_diagCreateCompute(device, cache, count, infos, alloc, pipelines);
+    for (uint32_t i = 0; i < count; i++) {
+      if (pipelines[i])
+        diagAdd(pipelines[i], 3u);
+    }
+    return vr;
+  }
+
+  static VKAPI_ATTR void VKAPI_CALL diagDestroyPipeline(VkDevice device, VkPipeline pipeline, const VkAllocationCallbacks* alloc) {
+    if (pipeline) {
+      std::lock_guard lock(s_diagMutex);
+      auto e = s_diagKinds.find(uint64_t(pipeline));
+      if (e != s_diagKinds.end()) {
+        s_diagCounts.live[e->second] -= 1;
+        s_diagKinds.erase(e);
+      }
+    }
+    s_diagDestroy(device, pipeline, alloc);
+  }
+
+  DiagPipelineCounts diagPipelineCounts() {
+    std::lock_guard lock(s_diagMutex);
+    return s_diagCounts;
+  }
+
   static std::pair<HMODULE, PFN_vkGetInstanceProcAddr> loadVulkanLibrary() {
     static const std::array<const char*, 2> dllNames = {{
 #ifdef _WIN32
@@ -99,7 +165,16 @@ namespace dxvk::vk {
   
   
   DeviceFn::DeviceFn(const Rc<InstanceLoader>& library, bool owned, VkDevice device)
-  : DeviceLoader(library, owned, device) { }
