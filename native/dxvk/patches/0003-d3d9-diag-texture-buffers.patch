+    if (env::getEnvVar("DXVK_TS3_DIAG") == "1" && !s_diagDestroy && vkCreateGraphicsPipelines && vkCreateComputePipelines && vkDestroyPipeline) {
+      s_diagCreateGraphics = vkCreateGraphicsPipelines;
+      s_diagCreateCompute = vkCreateComputePipelines;
+      s_diagDestroy = vkDestroyPipeline;
+      vkCreateGraphicsPipelines = &diagCreateGraphicsPipelines;
+      vkCreateComputePipelines = &diagCreateComputePipelines;
+      vkDestroyPipeline = &diagDestroyPipeline;
+    }
+  }
   DeviceFn::~DeviceFn() {
     if (m_owned)
       this->vkDestroyDevice(m_device, nullptr);
